# Aurora Poker App - Environment Variables
# Copy this file to .env and fill in your values

# ==================== Databricks ML Integration ====================
# Your Databricks workspace URL (e.g., https://your-workspace.cloud.databricks.com)
DATABRICKS_WORKSPACE_URL=

# Personal Access Token from Databricks
DATABRICKS_TOKEN=

# ==================== AI Services ====================
# Anthropic API Key (for Claude AI Advisor)
ANTHROPIC_API_KEY=

# OpenAI API Key (for bot agents - optional)
OPENAI_API_KEY=

# Enable OpenAI-powered bots (set to "true" to enable)
ENABLE_OPENAI_BOTS=false

# OpenAI model to use for bots
OPENAI_MODEL=gpt-4o-mini

# ==================== Frontend Configuration ====================
# Backend API URL (for frontend build)
VITE_API_BASE=http://localhost:8000

# ==================== GCP Configuration (Production) ====================
# GCP Project ID
GCP_PROJECT_ID=

# GCP Region for Cloud Run
GCP_REGION=us-central1

# ==================== Database (Optional) ====================
# PostgreSQL connection string (if using persistent storage)
DATABASE_URL=
