# Aurora Poker Backend Configuration
# Copy this file to .env and fill in your values

# ==========================================
# GCP Configuration (Recommended for Production)
# ==========================================
# When running in GCP, credentials are loaded from Secret Manager.
# Set this to your GCP project ID:
GCP_PROJECT=mlpoker

# Required secrets in Secret Manager:
# - databricks_workspace_url: Your Databricks workspace URL
# - databricks_token: Databricks Personal Access Token
# - db_user: PostgreSQL username
# - db_password: PostgreSQL password
# - db_name (optional): Database name, defaults to poker_ml
# - CLOUD_SQL_CONNECTION_NAME (optional): project:region:instance for Cloud SQL

# ==========================================
# Databricks Configuration (for local dev)
# ==========================================
# Only needed if NOT using Secret Manager
# DATABRICKS_WORKSPACE_URL=https://adb-1234567890123456.12.azuredatabricks.net
# DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Service Principal auth (for production)
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# ==========================================
# PostgreSQL Database (for local dev)
# ==========================================
# Only needed if NOT using Secret Manager
# For direct connection: postgresql://user:password@host:5432/poker_ml
# DATABASE_URL=

# ==========================================
# OpenAI Configuration (for LLM bots)
# ==========================================
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
ENABLE_OPENAI_BOTS=false

# ==========================================
# Feature Flags
# ==========================================
# Enable/disable ML predictions
ML_PREDICTIONS_ENABLED=true

# Enable/disable database storage
ML_STORAGE_ENABLED=true

# Use fallback predictions when endpoints unavailable
ML_FALLBACK_ENABLED=true
